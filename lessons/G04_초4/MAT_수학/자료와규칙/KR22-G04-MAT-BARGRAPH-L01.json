  "objectives": [
    {
      "id": "A",
      "text": "막대그래프에서 가로·세로가 나타내는 것과 눈금 한 칸의 크기를 알고, 막대가 나타내는 수와 가장 많은 것, 두 항목의 차이를 읽는다.",
      "evidence": "눈금 한 칸이 2·5·10인 그래프 읽기(S06, S07, S10, 활동지 1)",
      "success": "세로 눈금 숫자로 한 칸의 크기를 먼저 말하고, 칸 수 × 한 칸의 크기로 수를 읽으며 차이를 바르게 구한다."
    },
    {
      "id": "B",
      "text": "표를 보고 가로·세로와 눈금 한 칸의 크기를 정해 막대의 칸 수를 구하고 막대그래프로 나타낸다.",
      "evidence": "표에 맞는 그래프 고르기(S09), 칸 수 정하기(S12), 막대그래프 그리기(활동지 2)",
      "success": "표의 수 ÷ 한 칸의 크기로 막대 높이를 정해 그리고, 제목을 붙이며, 그린 그래프를 표와 대조한다."
    }
  ],
  "materials": [
    "바둑돌이나 단추 15개",
    "자 또는 종이 띠",
    "색연필",
    "연필",
    "활동지"
  ],
  "boundary": "세로 막대그래프만 다루며, 눈금 한 칸이 1·2·5·10이고 막대 끝이 눈금에 딱 맞는 자료만 쓴다. 가로 막대그래프는 노트에서 말로만 소개한다. 화면의 그래프는 PowerPoint 차트라서 세로 눈금마다 숫자가 쓰여 있다. 활동지 그래프는 선으로 그린 그림이다. 꺾은선그래프는 다음 차시에서 다룬다.",
  "misconceptions": [
