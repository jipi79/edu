  "objectives": [
    {
      "id": "A",
      "text": "공을 주고받아 골을 넣는 팀 경기의 협력 원리(공간·패스 길·역할·신호)를 설명하고, 경기장 그림에서 수비를 비켜 패스 길을 여는 자리를 고르며 패스·받기·주고 움직이기를 연습한다.",
      "evidence": "협력의 네 원리(S03), 막힌 길과 열린 길(S04), 기능 연습(S05), 오개념 비교(S08), 혼자 해 보기(S10 ①②), 활동지 1",
      "success": "S04 그림에서 가족이 움직여 길이 열린 까닭을 말하고, 새 상황 그림에서 의자와 일직선이 아니고 너무 가깝지 않은 자리(나)를 고른다."
    },
    {
      "id": "B",
      "text": "간이 경기 기록에서 가장 큰 문제 상황을 찾아 맞는 협력 전략 하나와 역할·신호를 정하고, 둘째 판에서 부모와 함께 실행한 뒤 두 판의 기록을 숫자로 견주어 효과와 다음에 바꿀 점을 말한다.",
      "evidence": "상황에 맞는 전략(S06), 전략 고르기(S07), 간이 경기(S09), 혼자 해 보기(S10 ③), 활동지 2·3·4·5",
      "success": "예시 기록(가로챔 3)에서 ‘받을 사람이 빈 곳으로, 손 들고 “여기!”’를 고르고, 간이 경기에서 관찰 기준 네 가지 가운데 세 가지 이상과 안전 규칙을 모두 지키며 두 판을 견준다."
    }
  ],
  "materials": [
    "양말 공(양말 두세 켤레를 뭉쳐 만듦)",
    "빨래 바구니(골대), 의자 하나(수비), 마스킹 테이프",
    "타이머, 물, 활동지, 연필"
  ],
  "boundary": "공을 주고받아 골을 넣는 팀 경기(농구·핸드볼 등)의 협력 원리(공간·패스 길·역할·신호), 낮은 패스·받기·주고 움직이기, 의자를 수비로 둔 간이 경기의 기록과 상황별 전략 세우기를 다룬다. 실제 종목의 공식 규칙과 반칙, 슛 기술, 몸싸움이 있는 수비, 뛰는 경기는 다루지 않는다. 간이 경기와 예시 기록은 수업을 위해 지어낸 것이다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "가로챔이 많으면 공을 더 세게, 멀리 던지면 된다고 생각한다.",
      "response": "막힌 길과 열린 길 그림으로 공 없는 사람의 움직임이 길을 연다는 것을 보이고, 세게 던지기의 위험을 짚는다(S04, S08)."
    },
    {
      "id": "M2",
      "text": "협력은 공 가진 사람이 잘하면 된다고 생각해 공 없는 사람은 제자리에 서 있는다.",
      "response": "역할 원리와 ‘주고 움직이기’ 연습으로 공 없는 사람의 일을 익힌다(S03, S05)."
    },
    {
      "id": "M3",
      "text": "둘째 판에 전략을 한꺼번에 여러 개 바꾼다.",
      "response": "가장 큰 문제 하나에 맞는 전략 하나와 역할·신호를 정하고 두 판을 견준다(S06, S09)."
    }
  ],
