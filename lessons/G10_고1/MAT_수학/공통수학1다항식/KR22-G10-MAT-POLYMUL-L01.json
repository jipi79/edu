  "objectives": [
    {
      "id": "A",
      "text": "분배법칙과 곱셈 표로 (이항식) × (삼항식)을 빠짐없이 전개하고 동류항을 모아 내림차순으로 정리한다.",
      "evidence": "곱셈 표(S03), 연습(S04), 혼자 해 보기(S13 ①), 마무리(S15 ①), 활동지 1",
      "success": "(x + 2)(x² − x + 3)을 여섯 칸의 곱으로 나누어 x³ + x² + x + 6으로, (2x − 1)(x² + x + 1)을 2x³ + x² + x − 1로 전개한다."
    },
    {
      "id": "B",
      "text": "(a + b)³ = a³ + 3a²b + 3ab² + b³, (a − b)³ = a³ − 3a²b + 3ab² − b³을 (a + b)(a + b)²의 전개로 설명하고, 단항식을 넣어 전개한다.",
      "evidence": "유도(S05, S06), 시범(S07), 연습(S08, S09), 혼자 해 보기(S13 ②③), 마무리(S15 ①②), 활동지 2·5",
      "success": "(x − 2)³ = x³ − 6x² + 12x − 8, (2x + 1)³ = 8x³ + 12x² + 6x + 1로 전개하고, (x + 2)³ = x³ + 8이 틀린 까닭을 x = 1 대입(27 ≠ 9)으로 설명한다."
    },
    {
      "id": "C",
      "text": "(a + b + c)² = a² + b² + c² + 2ab + 2bc + 2ca와 (a ± b)(a² ∓ ab + b²) = a³ ± b³을 넓이 그림과 전개로 확인하고 공식에 넣어 전개한다.",
      "evidence": "넓이 그림(S10), 시범(S11), 연습(S12), 혼자 해 보기(S13 ④⑤⑥), 마무리(S15 ③), 활동지 3·4",
      "success": "(x − 2y + 1)² = x² + 4y² + 1 − 4xy − 4y + 2x, (x + 3)(x² − 3x + 9) = x³ + 27로 전개한다."
    }
  ],
  "materials": [
    "공책",
    "연필",
    "색연필",
    "활동지"
  ],
  "boundary": "(이항식) × (삼항식)의 전개, 곱셈 공식 (a ± b)³, (a + b + c)², (a ± b)(a² ∓ ab + b²) = a³ ± b³과 계수·문자가 있는 항을 넣은 전개, 두 공식을 이어 쓰는 간단한 전개((x³ − 1)(x³ + 1))를 다룬다. 곱셈 공식의 변형(a³ + b³ = (a + b)³ − 3ab(a + b) 등), (x + a)(x + b)(x + c) 꼴의 공식, 다항식의 나눗셈(다음 차시)은 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "(a + b)³을 a³ + b³으로 쓴다((x + 2)³ = x³ + 8).",
      "response": "(a + b)(a + b)²으로 전개하고 x = 1을 넣어 값을 비교한다(S05, S09)."
    },
    {
      "id": "M2",
      "text": "(a + b + c)²에서 곱의 항을 빠뜨리거나 2배를 하지 않는다((x + y + 1)² = x² + y² + 1).",
      "response": "아홉 조각 넓이 그림에서 ab, bc, ca가 두 개씩임을 센다(S10, S12)."
    },
    {
      "id": "M3",
      "text": "계수가 있는 항을 공식에 넣을 때 계수를 세제곱하지 않는다((2x)³ = 2x³).",
      "response": "a 자리에 괄호를 씌워 (2x)³ = 2x × 2x × 2x = 8x³으로 계산한다(S07, S08, S14)."
    },
    {
      "id": "M4",
      "text": "(a − b)³의 부호를 모두 −로 쓴다(a³ − 3a²b − 3ab² − b³).",
      "response": "b 자리에 −b를 넣어 (−b)² = b², (−b)³ = −b³을 확인한다(S06)."
    }
  ],
