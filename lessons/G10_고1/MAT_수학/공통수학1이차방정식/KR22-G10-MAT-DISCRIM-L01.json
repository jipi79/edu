  "objectives": [
    {
      "id": "A",
      "text": "근의 공식으로 이차방정식을 복소수 범위에서 풀어, b² − 4ac < 0이면 √(−a) = √a i를 써서 근을 p ± qi 꼴로 간단히 나타내고, 실수인 근(실근)과 허수인 근(허근)을 구별한다.",
      "evidence": "시범(S03), 실근과 허근(S04), 연습(S05), 오개념 비교(S06), 혼자 해 보기(S12 ①②), 마무리(S14 ②), 활동지 1·4",
      "success": "x² − 2x + 5 = 0을 x = (2 ± √(−16))/2 = 1 ± 2i로, x² + x + 1 = 0을 x = (−1 ± √3 i)/2로 풀고, ‘근이 없다’는 말이 실수 범위에서만 맞음을 대입으로 설명한다."
    },
    {
      "id": "B",
      "text": "판별식 D = b² − 4ac의 부호로 근을 판별하고(D > 0 서로 다른 두 실근, D = 0 중근, D < 0 서로 다른 두 허근), 근의 종류가 주어질 때 판별식의 등식·부등식으로 k의 값이나 범위를 구한다.",
      "evidence": "판별식(S07), 시범(S08, S10), 연습(S09, S11), 혼자 해 보기(S12 ③~⑥), 마무리(S14 ①), 활동지 2·3",
      "success": "x² − 5x + 3 = 0(D = 13), 4x² − 4x + 1 = 0(D = 0), x² + 3x + 4 = 0(D = −7)의 근을 판별하고, x² + 4x + k = 0이 중근을 가질 때 k = 4, 허근을 가질 때 k > 4, 실근을 가질 때 k ≤ 4임을 구한다."
    }
  ],
  "materials": [
    "공책",
    "연필",
    "색연필",
    "활동지"
  ],
  "boundary": "계수가 정수인 이차방정식을 근의 공식으로 복소수 범위에서 풀기(실근·허근), 판별식 D = b² − 4ac의 부호에 따른 근의 판별, 근의 종류가 주어질 때 k의 값이나 범위 구하기(k에 대한 일차부등식, k² = 36 꼴)를 다룬다. x의 계수가 짝수일 때의 D/4 = b′² − ac는 노트의 참고로만 소개한다. 판별식은 계수가 실수일 때만 쓰며, 계수가 허수인 방정식과 근과 계수의 관계(다음 차시)는 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "b² − 4ac < 0이면 근이 없다고 한다(실수 범위에서만 맞는 말을 그대로 씀).",
      "response": "허근을 방정식에 대입해 0이 됨을 보이고, ‘실근이 없다’로 고쳐 말한다(S06, 활동지 4)."
    },
    {
      "id": "M2",
      "text": "허근을 약분할 때 분자의 한 항만 나눈다((2 ± 4i)/2 = 1 ± 4i).",
      "response": "분자의 실수부분과 허수부분을 모두 나눈다(S02 ③, S03)."
    },
    {
      "id": "M3",
      "text": "‘실근을 가진다’를 D > 0으로만 쓰고 중근(D = 0)을 뺀다.",
      "response": "중근도 실근이므로 D ≥ 0임을 표로 확인한다(S07, S10, S14 ①)."
    },
    {
      "id": "M4",
      "text": "판별식을 계산할 때 c의 부호를 놓치거나 정리하지 않은 식에서 a, b, c를 읽는다.",
      "response": "ax² + bx + c = 0 꼴로 정리하고 4ac를 따로 계산한다(S09 ④⑥)."
    }
  ],
