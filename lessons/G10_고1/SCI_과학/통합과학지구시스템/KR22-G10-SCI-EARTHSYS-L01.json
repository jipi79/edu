  "objectives": [
    {
      "id": "A",
      "text": "지구 시스템을 이루는 지권·수권·기권·생물권·외권을 예로 구별하고, 지구 시스템의 에너지원(태양 에너지·지구 내부 에너지·조력 에너지)이 각각 일으키는 현상을 말한다.",
      "evidence": "다섯 권(S03), 연습(S04), 에너지원(S05), 오개념 비교(S06), 혼자 해 보기(S14 ①②), 마무리(S16 ①), 활동지 2",
      "success": "지하수·공기·나무·우주 공간을 각각 수권·기권·생물권·외권으로 나누고, 바람과 비는 태양 에너지, 지진·화산은 지구 내부 에너지, 밀물·썰물은 조력 에너지라고 말한다."
    },
    {
      "id": "B",
      "text": "물 순환 모형 실험 결과를 근거로 물이 증발·응결·강수로 권 사이를 순환함을 설명하고, 탄소가 광합성·호흡·녹음·퇴적·연소로 기권·생물권·수권·지권 사이를 이동하는 과정을 ‘어디에서 → 어디로’로 말한다.",
      "evidence": "예상·실험·결과(S07~S09), 물의 순환(S10), 탄소의 순환(S11), 연습(S12), 오개념 비교(S13), 혼자 해 보기(S14 ③④), 마무리(S16 ②), 활동지 1·3·4",
      "success": "바닷물의 증발을 수권 → 기권으로, 광합성을 기권 → 생물권으로, 화석 연료의 연소를 지권 → 기권으로 말하고, 탄소는 새로 생기지 않고 권 사이를 옮겨 다닌다고 설명한다."
    }
  ],
  "materials": [
    "투명한 큰 그릇(유리그릇 또는 플라스틱 통)",
    "랩",
    "고무줄",
    "얼음 서너 개",
    "따뜻한 수돗물(부모님이 받음)",
    "수건",
    "활동지",
    "연필"
  ],
  "boundary": "지구 시스템의 다섯 권과 세 에너지원, 물·탄소 순환의 주요 경로를 간단한 그림 수준에서 다룬다. 권 사이 에너지의 양(수치), 질소 순환, 기후 되먹임, 판의 움직임(다음 차시)은 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "바람·비 같은 기상 현상도 지구 내부 에너지(땅속의 열)로 생긴다고 생각한다.",
      "response": "에너지원과 일으키는 현상을 표로 짝짓고, 태풍이 따뜻한 바다에서 생기는 까닭을 태양 에너지로 설명한다(S05, S06)."
    },
    {
      "id": "M2",
      "text": "화석 연료를 태우면 탄소가 새로 생긴다고 생각한다.",
      "response": "탄소는 새로 생기거나 없어지지 않고 지권에서 기권으로 옮겨 간다는 것을 순환 그림으로 확인한다(S11, S13)."
    },
    {
      "id": "M3",
      "text": "물질의 이동 방향(어디에서 어디로)을 거꾸로 말한다(광합성을 생물권 → 기권으로).",
      "response": "‘처음 있던 곳 → 나중에 있는 곳’으로 말하는 틀을 쓰고 그림의 화살표를 손가락으로 따라간다(S12)."
    }
  ],
