  "objectives": [
    {
      "id": "A",
      "text": "수직선에서 0과 그 수 사이의 거리로 절댓값의 뜻을 알고, 정수·소수·분수의 절댓값을 기호 | |를 써서 구하며, 절댓값이 같은 두 수를 찾는다.",
      "evidence": "절댓값(S04, S11 ①②, S13 ②, 활동지 1·2)",
      "success": "|−9| = 9, |0| = 0을 구하고, 절댓값이 6인 수를 +6과 −6 두 개로 답한다."
    },
    {
      "id": "B",
      "text": "수직선(오른쪽에 있을수록 큼)과 절댓값(음수끼리는 절댓값이 큰 수가 작음)을 이용해 두 유리수의 크기를 비교하고 부등호 >, <로 나타낸다.",
      "evidence": "대소 비교(S07, S08, S11 ③④, S13 ①③, 활동지 3·4·5)",
      "success": "−7 > −10, −4분의 3 < −3분의 2처럼 음수끼리의 대소를 바르게 나타내고, ‘절댓값이 크다’와 ‘수가 크다’를 구별해 반례(−5와 +2)를 든다."
    },
    {
      "id": "C",
      "text": "초과·미만·이상·이하를 부등호 >, <, ≥, ≤로 나타내고, 부등호로 나타낸 범위에 드는 정수를 찾는다.",
      "evidence": "부등호(S10, S11 ⑤⑥, 활동지 6·7)",
      "success": "‘x는 −2보다 크고 1 이하’를 −2 < x ≤ 1로 쓰고, 이를 만족하는 정수 −1, 0, 1을 빠짐없이 찾는다."
    }
  ],
  "materials": [
    "공책",
    "연필과 색연필 두 가지(주황·파랑)",
    "종이 띠(보충용)",
    "활동지"
  ],
  "boundary": "정수·소수·분수(분모 12 이하)의 절댓값, 두 유리수의 대소 비교와 여러 수의 순서, 초과·미만·이상·이하를 부등호로 나타내기와 그 범위의 정수 찾기를 다룬다. 절댓값을 이용한 덧셈(다음 차시), 절댓값이 들어간 방정식·부등식, 문자 x의 일반적인 사용(문자와 식 단원)은 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "음수끼리도 절댓값이 크면 더 큰 수라고 생각한다(−8 > −3).",
      "response": "기온(영하 8도와 영하 3도)과 수직선으로 왼쪽에 있을수록 작음을 확인한다(S05, S08, S13 ③)."
    },
    {
      "id": "M2",
      "text": "절댓값이 a인 수를 +a 하나만 쓴다.",
      "response": "수직선에서 0의 오른쪽과 왼쪽으로 같은 거리를 세어 두 점을 찾게 한다(S03, S04 ⑤)."
    },
    {
      "id": "M3",
      "text": "≤와 <(이상과 초과, 이하와 미만)를 바꿔 써서 경계의 수를 넣거나 뺀다.",
      "response": "‘같아도 되는가?’를 먼저 묻고, 수직선에 경계를 표시해 정수를 센다(S09, S10 ④, S11 ⑥)."
    },
    {
      "id": "M4",
      "text": "0의 절댓값이나 0과 음수의 대소를 헷갈린다(0 < −0.5, |0|은 없다).",
      "response": "0은 거리 0이며 모든 음수보다 오른쪽에 있음을 수직선으로 확인한다(S03, S07 ④)."
    }
  ],
