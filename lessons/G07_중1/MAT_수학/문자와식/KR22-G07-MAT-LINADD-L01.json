  "objectives": [
    {
      "id": "A",
      "text": "문자와 차수가 같은 항(동류항)을 찾아, 동류항끼리 모아 계수끼리 계산하여 식을 간단히 한다.",
      "evidence": "막대 그림 설명(S03), 동류항 계산(S05, S06, S12 ①②, 활동지 1·2)",
      "success": "4x − 7 − 6x + 3 = −2x − 4처럼 부호와 함께 동류항끼리 모아 계산하고, 3x + 2는 동류항이 없어 더 간단히 할 수 없다고 설명한다."
    },
    {
      "id": "B",
      "text": "괄호 앞의 부호(+, −)와 수에 따라 괄호를 풀고 동류항끼리 모아 일차식의 덧셈과 뺄셈을 한다.",
      "evidence": "괄호 풀기와 덧셈·뺄셈(S10, S11, S12 ③~⑥, S14, 활동지 3~6)",
      "success": "(5x − 2) − (3x − 4) = 5x − 2 − 3x + 4 = 2x + 2처럼 빼는 식의 모든 항의 부호를 바꾸고, x에 수를 넣어 결과를 확인한다."
    }
  ],
  "materials": [
    "공책",
    "연필과 색연필",
    "종이 띠(긴 것·짧은 것, 보충용)",
    "활동지"
  ],
  "boundary": "동류항의 뜻과 계산, 괄호 앞에 +, −, 수가 있는 일차식의 덧셈과 뺄셈을 다룬다. 분수 꼴 일차식의 덧셈·뺄셈(통분이 필요한 식), 중괄호가 있는 여러 겹의 괄호, 이차식의 계산, 방정식은 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "동류항이 아닌 항을 더한다(3x + 2 = 5x).",
      "response": "막대 그림에서 x 막대와 1 조각을 합칠 수 없음을 보고, x = 2를 넣어 값을 비교한다(S03, S06)."
    },
    {
      "id": "M2",
      "text": "동류항을 계산하며 문자를 빠뜨리거나 차수를 바꾼다(7a − 2a = 5, 2x + 3x = 5x²).",
      "response": "계수끼리만 계산하고 문자는 그대로 쓴다는 것을 막대 그림으로 보인다(S03, S04)."
    },
    {
      "id": "M3",
      "text": "−( )를 풀 때 첫 항의 부호만 바꾼다((4x + 3) − (x − 2) = 4x + 3 − x − 2).",
      "response": "−( )는 (−1)을 곱한 것임을 분배법칙으로 보이고, 식의 값으로 확인한다(S07, S09, S11)."
    },
    {
      "id": "M4",
      "text": "괄호 앞에 음수가 곱해진 경우 뒤 항의 부호를 잘못 정한다(−2(y − 4) = −2y − 8).",
      "response": "괄호를 푼 식을 먼저 한 줄 쓰고 부호를 하나씩 확인하게 한다(S10 ⑤, S12 ⑥)."
    }
  ],
