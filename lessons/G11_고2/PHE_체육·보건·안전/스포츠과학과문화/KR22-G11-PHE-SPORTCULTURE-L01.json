  "objectives": [
    {
      "id": "A",
      "text": "경기 기록(예시 농구 경기, 경기 영상 5분 기록)에서 성공률·점수·슛 한 번당 평균 득점(성공률 × 점수)을 구하고, 여러 기록을 함께 보아 팀의 강점과 고칠 점을 찾아 전략을 제안한다.",
      "evidence": "예시 기록(S03), 성공률과 점수(S04), 한 번당 평균 득점과 전략(S05), 영상 기록(S06), 이긴 팀 비교(S07), 혼자 해 보기 ①~③(S12), 활동지 1·2",
      "success": "푸른팀 2점 50%·3점 30%·68점, 한 번당 1.0점·0.9점을 구해 ‘안쪽 공격 늘리기’를, 하늘팀의 턴오버 14로 ‘턴오버 줄이기’를 제안한다."
    },
    {
      "id": "B",
      "text": "공정·스포츠맨십·관람 문화·스포츠 미디어의 가치로 사례를 판단하고, 스포츠 쟁점(비디오 판독 확대 등)을 여러 입장에서 토의해 주장·근거·다른 의견에 대한 답으로 자기 의견을 정리한다.",
      "evidence": "스포츠 문화의 가치(S08), 사례 판단(S09), 쟁점(S10), 토의와 의견 정리(S11), 혼자 해 보기 ④(S12), 활동지 3·4",
      "success": "상대 비하 구호를 관람 문화 위반으로 판단해 북돋는 응원으로 바꾸고, 비디오 판독 쟁점에서 근거 두 가지와 반론에 대한 답을 쓴다."
    }
  ],
  "materials": [
    "활동지",
    "필기구",
    "계산기(선택)",
    "공식 방송·리그 채널의 경기 영상(부모님과 함께 고름)"
  ],
  "boundary": "경기 기록의 성공률·점수·슛 한 번당 평균 득점 계산, 여러 기록으로 강점과 고칠 점을 찾아 전략 제안하기, 경기 영상 5분 기록, 스포츠 문화의 가치(공정·스포츠맨십·관람 문화·스포츠 미디어), 쟁점 토의와 의견 정리를 다룬다. 실제 팀·선수·사건을 평가하지 않고, 쟁점에 정답을 정하지 않는다. 경기 기록과 사례는 수업을 위해 지어낸 예시이다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "이긴 팀은 모든 기록에서 앞섰다고 생각하거나, 점수나 기록 하나만으로 경기를 판단한다.",
      "response": "두 팀이 앞선 기록을 함께 찾고 한 번당 평균 득점으로 전략을 따진다(S04, S05, S07)."
    },
    {
      "id": "M2",
      "text": "상대 선수를 놀리거나 야유하는 것도 응원의 일부라고 생각한다.",
      "response": "응원(우리 팀 북돋기)과 비하를 구별하고 사례로 바람직한 행동을 찾는다(S08, S09, S12 ④)."
    },
    {
      "id": "M3",
      "text": "스포츠 쟁점에는 정답이 하나 있으며 다른 의견은 틀렸다고 생각한다.",
      "response": "찬성·신중 의견의 근거를 나란히 보고 다른 의견에 답하는 형식으로 의견을 정리한다(S10, S11)."
    }
  ],
