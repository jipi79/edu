  "objectives": [
    {
      "id": "A",
      "text": "분모가 다른 진분수끼리의 뺄셈을 분모의 곱이나 최소공배수로 통분하여 계산하고, 답을 기약분수로 나타내며 띠 그림으로 설명한다.",
      "evidence": "띠 그림 설명(S03), 두 방법 비교(S04), 통분하여 빼기(S05, S11 ①②, 활동지 1·2)",
      "success": "3분의 2 − 4분의 1 = 12분의 8 − 12분의 3 = 12분의 5처럼 계산하고, 빼고 나서 약분할 수 있으면 기약분수로 나타낸다."
    },
    {
      "id": "B",
      "text": "분모가 다른 대분수끼리의 뺄셈을 분수 부분을 통분한 뒤 자연수끼리·분수끼리 빼서 계산하고, 분수 부분끼리 뺄 수 없으면 자연수 1을 분모와 분자가 같은 분수로 바꾸어 받아내린다.",
      "evidence": "대분수의 뺄셈(S06, S08, S09, S11 ③④, 활동지 3·4·5), 막대 그림(S07), 토끼와 곰 비교(S10), 바르게 바꾼 것 고르기(S13)",
      "success": "3과 5분의 1 − 1과 2분의 1 = 2와 10분의 12 − 1과 10분의 5 = 1과 10분의 7처럼 계산하고, 받아내린 까닭을 ‘1 = 10분의 10’으로 설명한다."
    }
  ],
  "materials": [
    "같은 길이의 종이 띠 4장(A4 용지를 길게 잘라 만듦)",
    "가위",
    "색연필",
    "연필",
    "활동지"
  ],
  "boundary": "분모가 다른 (진분수)−(진분수), (대분수)−(대분수)의 뺄셈(받아내림 포함)을 통분으로 계산하고 답을 기약분수·대분수로 나타낸다. 가분수로 바꾸어 빼는 방법은 노트에서만 소개한다. (자연수)−(분수)(초4), 세 분수의 계산, 덧셈과 뺄셈이 섞인 계산은 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "분자끼리, 분모끼리 뺀다(4분의 3 − 2분의 1 = 2분의 2).",
      "response": "답이 빼기 전 수보다 커지는 모순을 짚고, 통분하여 같은 크기의 칸끼리 빼게 한다(S03, S05)."
    },
    {
      "id": "M2",
      "text": "분수 부분끼리 뺄 수 없을 때 거꾸로 뺀다(4와 12분의 4 − 1과 12분의 9 = 3과 12분의 5).",
      "response": "막대 하나를 쪼개는 받아내림을 그림으로 보고, 답에 빼는 수를 더해 처음 수가 나오는지 확인한다(S07, S10)."
    },
    {
      "id": "M3",
      "text": "받아내림한 뒤 자연수에서 1을 빼지 않거나(5와 12분의 14), 원래 있던 분수를 더하지 않는다(4와 12분의 12).",
      "response": "‘자연수가 1 줄고 그만큼 분수가 는다’를 막대로 확인한다(S07, S13)."
    },
    {
      "id": "M4",
      "text": "답을 약분하지 않는다(30분의 16, 1과 6분의 3).",
      "response": "크기는 맞는 답임을 인정하고 기약분수로 나타내게 한다(S04, S09, S12)."
    }
  ],
