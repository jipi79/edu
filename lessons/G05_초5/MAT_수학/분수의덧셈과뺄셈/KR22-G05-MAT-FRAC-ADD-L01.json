  "objectives": [
    {
      "id": "A",
      "text": "분모가 다른 진분수끼리의 덧셈을 분모의 곱이나 최소공배수로 통분하여 계산하고, 답을 기약분수나 대분수로 나타내며 띠 그림으로 설명한다.",
      "evidence": "띠 그림 설명(S03), 두 방법 비교(S04), 통분하여 더하기(S05, S06, S11 ①②③, 활동지 1·2·3), 토끼와 곰 비교(S07), 어림으로 답 고르기(S13)",
      "success": "2분의 1 + 3분의 1 = 6분의 3 + 6분의 2 = 6분의 5처럼 계산하고, 분모끼리 더하면 안 되는 까닭을 ‘한 칸의 크기가 달라서’ 또는 ‘답이 2분의 1보다 작아져서’라고 말한다."
    },
    {
      "id": "B",
      "text": "분모가 다른 대분수끼리의 덧셈을 분수 부분을 통분한 뒤 자연수끼리·분수끼리 더하여 계산하고, 분수 부분의 합이 1 이상이면 자연수로 받아올린다.",
      "evidence": "대분수의 덧셈(S08, S09, S10, S11 ④, 활동지 4)",
      "success": "2와 4분의 3 + 1과 6분의 5 = 3과 12분의 19 = 4와 12분의 7처럼 받아올림까지 바르게 계산하고, 받아올린 까닭을 ‘12분의 12 = 1’로 말한다."
    }
  ],
  "materials": [
    "같은 길이의 종이 띠 3장(A4 용지를 길게 잘라 만듦)",
    "색연필",
    "연필",
    "활동지"
  ],
  "boundary": "분모가 다른 (진분수)+(진분수), (대분수)+(대분수)의 덧셈(받아올림 포함)을 통분으로 계산하고, 답을 기약분수·대분수로 나타낸다. 가분수로 바꾸어 더하는 방법은 노트에서만 소개한다. 세 분수의 덧셈과 분모가 다른 분수의 뺄셈은 다루지 않는다(뺄셈은 다음 차시).",
  "misconceptions": [
    {
      "id": "M1",
      "text": "분자끼리, 분모끼리 더한다(2분의 1 + 3분의 1 = 5분의 2).",
      "response": "답이 더하는 수(2분의 1)보다 작아진다는 것을 띠로 확인하고, 한 칸의 크기가 같아야 칸 수를 더할 수 있음을 말한다(S03, S07)."
    },
    {
      "id": "M2",
      "text": "통분할 때 분모만 바꾸고 분자는 그대로 둔다(5분의 2 → 15분의 2).",
      "response": "통분은 분모와 분자에 같은 수를 곱하는 것임을 다시 확인한다(S02, S05)."
    },
    {
      "id": "M3",
      "text": "답을 약분하지 않거나 가분수로 둔다(30분의 14, 12분의 19).",
      "response": "크기는 맞는 답임을 인정하고, 기약분수·대분수로 나타내는 약속에 따라 고쳐 쓰게 한다(S04, S06, S12)."
    },
    {
      "id": "M4",
      "text": "대분수의 덧셈에서 분수 부분의 합이 1을 넘어도 받아올리지 않거나(3과 12분의 19), 받아올린 1을 자연수에 더하지 않는다(3과 12분의 7).",
      "response": "12분의 12 = 1을 자연수로 옮기는 것을 띠 그림과 함께 확인한다(S06, S09)."
    }
  ],
