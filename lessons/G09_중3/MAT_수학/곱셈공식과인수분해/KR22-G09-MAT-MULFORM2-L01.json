  "objectives": [
    {
      "id": "A",
      "text": "(a + b)(a − b) = a² − b²을 전개와 넓이 모형으로 설명하고, 공식에 단항식을 넣어 전개하며, 102 × 98 같은 수의 곱셈에 쓴다.",
      "evidence": "전개와 넓이(S03, S04), 시범(S05), 연습(S06, S07), 혼자 해 보기(S13 ①②), 마무리(S15 ①), 활동지 1·3",
      "success": "(2x + 3y)(2x − 3y) = 4x² − 9y², (−x + 2)(x + 2) = 4 − x²으로 전개하고, 102 × 98 = 10000 − 4 = 9996, 201 × 199 = 39999를 공식으로 계산한다."
    },
    {
      "id": "B",
      "text": "(x + a)(x + b) = x² + (a + b)x + ab와 (ax + b)(cx + d) = acx² + (ad + bc)x + bd를 넓이 모형과 전개로 설명하고, 부호를 포함한 두 수의 합과 곱으로 전개한다.",
      "evidence": "넓이 모형(S08), 시범(S09, S10), 연습(S11, S12), 혼자 해 보기(S13 ③~⑥), 마무리(S15 ②), 활동지 2·4",
      "success": "(x − 3)(x + 4) = x² + x − 12, (2x + 1)(3x + 4) = 6x² + 11x + 4로 전개하고, x의 계수를 5로 쓴 답을 x = 1 대입(15 ≠ 21)으로 반박한다."
    }
  ],
  "materials": [
    "공책",
    "연필",
    "색연필",
    "종이와 가위",
    "활동지"
  ],
  "boundary": "곱셈 공식 (a + b)(a − b) = a² − b², (x + a)(x + b) = x² + (a + b)x + ab, (ax + b)(cx + d) = acx² + (ad + bc)x + bd와 계수·문자가 있는 항을 넣은 전개, 합차 공식을 이용한 수의 곱셈(102 × 98, 201 × 199), 공식을 거꾸로 써서 빈칸 구하기를 다룬다. 인수분해는 다음 차시부터, 곱셈 공식을 이용한 분모의 유리화와 근호가 있는 식의 전개는 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "(a + b)(a − b)의 마지막 항을 +b²으로 쓴다((x + 2)(x − 2) = x² + 4).",
      "response": "(+2) × (−2) = −4를 확인하고 x = 1을 넣어 값을 비교한다(S03, S07)."
    },
    {
      "id": "M2",
      "text": "(ax + b)(cx + d)에서 x의 계수를 b + d로 쓴다((2x + 1)(3x + 4) = 6x² + 5x + 4).",
      "response": "x가 하나씩 있는 두 곱(ad, bc)을 화살표로 찾고 x = 1을 넣어 값을 비교한다(S10, S12)."
    },
    {
      "id": "M3",
      "text": "(x + a)(x + b)에서 상수항의 부호를 잘못 정한다((x − 4)(x − 5) = x² − 9x − 20).",
      "response": "부호를 포함한 두 수의 곱 (−4) × (−5) = +20을 따로 계산한다(S09, S11 ②)."
    },
    {
      "id": "M4",
      "text": "계수가 있는 항을 공식에 넣을 때 계수를 제곱하지 않는다((2x + 3y)(2x − 3y) = 2x² − 3y²).",
      "response": "a, b 자리에 괄호를 써서 (2x)² − (3y)²으로 계산한다(S05)."
    }
  ],
