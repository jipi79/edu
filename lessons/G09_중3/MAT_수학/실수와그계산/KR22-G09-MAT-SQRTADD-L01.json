  "objectives": [
    {
      "id": "A",
      "text": "근호 안의 수가 같은 항끼리 동류항처럼 근호 앞의 수를 더하거나 빼고, 근호 안의 수가 다른 항은 더 합치지 않는다(√2 + √3 ≠ √5).",
      "evidence": "타일 모형(S03), 시범(S04), 연습(S05, S06), 혼자 해 보기(S11 ①②), 활동지 1",
      "success": "2√3 + 5√3 = 7√3, 5√2 − 3√3 − 2√2 + √3 = 3√2 − 2√3을 계산하고, √2 + √3과 √5가 다름을 어림값(3.146과 2.236)으로 보인다."
    },
    {
      "id": "B",
      "text": "근호 안을 a√b 꼴로 간단히 하거나, 분모를 유리화하거나, 분배법칙으로 괄호를 푼 뒤 근호 안의 수가 같은 것끼리 계산한다.",
      "evidence": "시범(S07, S08), 연습(S09, S10), 혼자 해 보기(S11 ③~⑥), 마무리(S13), 활동지 2·3·4",
      "success": "√12 + √27 = 2√3 + 3√3 = 5√3, √20 + √5분의 10 = 4√5, √50 − 2√8 + √18 = 4√2, √3(√3 + 2) − 2√3 = 3을 계산한다."
    }
  ],
  "materials": [
    "공책",
    "연필",
    "색연필",
    "활동지"
  ],
  "boundary": "근호 안의 수가 같은 항끼리의 덧셈·뺄셈, a√b 꼴로 간단히 한 뒤의 덧셈·뺄셈, 분모를 유리화(분모가 √b, a√b 꼴)하거나 분배법칙(√a(√b + c))을 쓴 뒤의 덧셈·뺄셈, 어림값을 이용한 확인을 다룬다. 곱셈 공식을 쓰는 (√a + √b)²과 분모가 √a ± √b 꼴인 유리화는 이 과정에서 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "근호 안의 수끼리 더한다(√2 + √3 = √5, √12 + √27 = √39).",
      "response": "어림값으로 두 값이 다름을 보이고(S06, S10), 문자식 a + b를 ab나 2ab로 쓰지 않는 것과 비교한다(S04)."
    },
    {
      "id": "M2",
      "text": "근호 안을 간단히 하지 않아 같은 것끼리 모으지 못한다(√48 − √27을 √21로 쓰거나 그대로 둔다).",
      "response": "각 항을 먼저 a√b 꼴로 바꾸어 쓰게 한다(S07, S09)."
    },
    {
      "id": "M3",
      "text": "괄호 앞의 − 를 뒤 항에 적용하지 않는다(3√6 − (√6 − 2√2) = 2√6 − 2√2).",
      "response": "다항식의 뺄셈처럼 괄호를 풀며 모든 항의 부호를 바꾼다(S05 ⑥, 활동지 1 ④)."
    },
    {
      "id": "M4",
      "text": "√a 앞의 계수 1을 빠뜨려 계산한다(√7 − 4√7 = −4√7).",
      "response": "√7 = 1√7로 써서 계산하게 한다(S04 핵심, S05 ③)."
    }
  ],
