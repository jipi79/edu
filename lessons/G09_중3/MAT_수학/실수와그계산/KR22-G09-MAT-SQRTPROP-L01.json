  "objectives": [
    {
      "id": "A",
      "text": "(√a)² = a, (−√a)² = a, √(a²) = |a|를 이용해 근호를 없애 계산하고, a < 0이면 √(a²) = −a임을 수를 넣어 설명한다.",
      "evidence": "제곱근의 성질(S03, S04, S05), 연습(S06, S07), 혼자 해 보기(S13 ①②③⑥), 활동지 1·2",
      "success": "(−√11)² = 11, √((−8)²) = 8, −√((−5)²) = −5를 구하고, a = −2를 넣어 √(a²) = 2 = −a임을 보인다."
    },
    {
      "id": "B",
      "text": "양수 a, b에 대해 a < b이면 √a < √b임을 넓이로 설명하고, 자연수·소수를 근호로 바꾸어 두 수의 대소를 비교하며, 음의 제곱근끼리는 대소가 반대임을 수직선으로 확인한다.",
      "evidence": "대소 비교(S08, S09, S10), 연습(S11, S12), 혼자 해 보기(S13 ④⑤), 마무리(S15), 활동지 3·4·5",
      "success": "3 = √9 < √10, −√7 < −√5, √0.5 > 0.7을 이유와 함께 비교하고, √x < 3인 자연수 x가 8개임을 구한다."
    }
  ],
  "materials": [
    "공책",
    "연필",
    "활동지"
  ],
  "boundary": "(√a)² = a, (−√a)² = a, √(a²) = |a|(a < 0이면 −a)와 이를 이용해 근호를 없앤 계산, 양수인 두 제곱근의 대소, 제곱근과 자연수·소수의 대소, 음의 제곱근끼리의 대소, √x < k를 만족하는 자연수의 개수를 다룬다. √((a − 2)²)처럼 근호 안이 식인 경우와 1 + √2처럼 무리수가 들어간 식의 대소는 다음 차시 ‘무리수와 실수’ 이후에 다룬다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "근호와 제곱을 함께 지워 √((−5)²) = −5로 쓴다.",
      "response": "근호 안의 (−5)² = 25를 먼저 계산해 √25 = 5임을 보인다(S04, S07)."
    },
    {
      "id": "M2",
      "text": "a < 0일 때도 √(a²) = a로 쓴다.",
      "response": "a = −2를 넣어 √(a²) = 2 = −a임을 확인한다(S05, 활동지 2)."
    },
    {
      "id": "M3",
      "text": "음의 제곱근끼리도 근호 안이 크면 크다고 본다(−√7 > −√5).",
      "response": "수직선에서 0에서 먼 쪽이 작음을 보인다(S10, S12)."
    },
    {
      "id": "M4",
      "text": "자연수·소수와 제곱근을 비교할 때 근호 안의 수와 그대로 비교한다(0.7 > 0.5이므로 0.7 > √0.5).",
      "response": "같은 꼴로 바꾸어(0.7 = √0.49, 3 = √9) 근호 안끼리 비교한다(S09, S11 ④)."
    }
  ],
