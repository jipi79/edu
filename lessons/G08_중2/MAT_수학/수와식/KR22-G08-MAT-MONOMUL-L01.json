  "objectives": [
    {
      "id": "A",
      "text": "단항식의 곱셈에서 계수는 계수끼리, 문자는 문자끼리 곱하고 같은 문자는 지수법칙으로 정리하며, 괄호 밖에 지수가 있으면 먼저 계산하고 부호는 음수의 개수로 정한다.",
      "evidence": "넓이 모형 설명(S03), 단항식의 곱셈(S04, S05, S06, S07, S13 ①②, 활동지 1)",
      "success": "3a × 2b = 6ab를 넓이로 설명하고, (−3a²) × 4a³b = −12a⁵b, (−3a)² × 2a = 18a³처럼 부호·계수·문자를 바르게 정리한다."
    },
    {
      "id": "B",
      "text": "단항식의 나눗셈을 분수 꼴로 써서 약분하거나 나누는 식의 역수를 곱해 계산하고, 곱셈과 나눗셈이 섞인 식을 앞에서부터(÷를 역수의 곱셈으로 바꾸어) 계산한다.",
      "evidence": "나눗셈(S08, S09, S11 ①~④, S13 ③④⑤, 활동지 2·3), 섞인 계산(S10, S11 ⑤⑥, S12, S13 ⑥, S15, 활동지 4·5)",
      "success": "12a³ ÷ 4a = 3a², 6a²b ÷ 2분의 3a = 4ab로 계산하고, 6x² ÷ 2x × 3x를 1이 아니라 9x²으로 계산하며 x = 1을 넣어 확인한다."
    }
  ],
  "materials": [
    "공책",
    "연필과 색연필",
    "활동지"
  ],
  "boundary": "계수가 정수나 간단한 분수인 단항식끼리의 곱셈·나눗셈, 괄호 밖에 지수가 있는 단항식, 곱셈·나눗셈이 섞인 세 단항식의 계산, 간단히 한 뒤 식의 값 구하기를 다룬다. 다항식이 들어 있는 곱셈·나눗셈(‘단항식과 다항식의 곱셈·나눗셈’), 덧셈·뺄셈이 섞인 식, 문자가 셋 이상이거나 단항식이 넷 이상인 복잡한 식은 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "계수끼리 더하거나 같은 문자의 지수를 곱한다(2x² × 3x³ = 5x⁵ 또는 6x⁶).",
      "response": "넓이 모형과 곱셈의 순서 바꾸기로 계수끼리 곱함을 보이고 지수법칙을 다시 쓴다(S03, S04)."
    },
    {
      "id": "M2",
      "text": "음수 계수가 있는 단항식을 거듭제곱할 때 부호나 계수를 빠뜨린다((−3a)² = −9a²).",
      "response": "괄호 안의 식을 지수만큼 곱셈식으로 풀어 쓴다(S05, S07)."
    },
    {
      "id": "M3",
      "text": "나눗셈에서 계수만 나누고 문자는 약분하지 않는다(12a³ ÷ 4a = 3a³).",
      "response": "분수 꼴로 써서 계수와 문자를 따로 약분한다(S08)."
    },
    {
      "id": "M4",
      "text": "곱셈·나눗셈이 섞인 식에서 뒤의 곱셈을 먼저 묶는다(6x² ÷ 2x × 3x = 1).",
      "response": "÷를 역수의 곱셈으로 바꾸고 x = 1을 넣어 값을 비교한다(S10, S12)."
    },
    {
      "id": "M5",
      "text": "분수 꼴 단항식으로 나눌 때 역수를 일부만 바꾼다(÷ 2분의 3a를 × 3분의 2 × a로).",
      "response": "나누는 식 전체를 괄호로 묶고 분자와 분모를 통째로 바꾼다(S09, S13 ⑤)."
    }
  ],
