  "objectives": [
    {
      "id": "A",
      "text": "밑이 같은 거듭제곱의 나눗셈을 분수 꼴로 풀어 써서 약분으로 설명하고, 지수의 크기에 따라 aᵐ⁻ⁿ, 1, aⁿ⁻ᵐ분의 1로 간단히 한다(a ≠ 0).",
      "evidence": "분수로 풀어 써서 설명(S03, S04), 나눗셈 간단히 하기(S05, S06, S12 ①②③, S14 ①, 활동지 1·2)",
      "success": "a⁶ ÷ a² = a⁴, b⁵ ÷ b⁵ = 1, x³ ÷ x⁸ = x⁵분의 1처럼 큰 지수에서 작은 지수를 빼어 큰 쪽에 남기고, 같은 거듭제곱끼리 나누면 0이 아니라 1인 까닭을 말한다."
    },
    {
      "id": "B",
      "text": "곱의 거듭제곱 (ab)ⁿ = aⁿbⁿ과 몫의 거듭제곱 (b분의 a)ⁿ = bⁿ분의 aⁿ을 풀어 써서 설명하고, 계수와 음의 부호가 있는 식을 괄호 안에 곱해진 것 모두에 지수를 붙여 간단히 한다.",
      "evidence": "풀어 써서 설명(S07, S09), 곱·몫의 거듭제곱(S08, S10, S11, S12 ④⑤⑥, S14 ②③, 활동지 3·4·5)",
      "success": "(3x)² = 9x², (−2x²)³ = −8x⁶, (3분의 x)² = 9분의 x²처럼 계수·부호·분모까지 거듭제곱하고, (−x)²과 −x²이 다름을 값으로 보인다."
    }
  ],
  "materials": [
    "공책",
    "연필과 색연필",
    "활동지"
  ],
  "boundary": "a ≠ 0일 때 aᵐ ÷ aⁿ의 세 경우(m > n, m = n, m < n, 지수는 자연수), 곱의 거듭제곱 (ab)ⁿ = aⁿbⁿ, 몫의 거듭제곱(b ≠ 0), 계수·음의 부호가 있는 한 덩어리의 거듭제곱을 다룬다. 계수가 있는 단항식끼리의 곱셈·나눗셈(다음 차시), a⁰과 음의 지수의 정의, (a + b)ⁿ의 전개는 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "거듭제곱의 나눗셈에서 지수끼리 나눈다(a⁶ ÷ a² = a³).",
      "response": "분수로 풀어 써서 약분하고 a = 2를 넣어 값을 비교한다(S03, S06)."
    },
    {
      "id": "M2",
      "text": "지수가 같은 거듭제곱의 나눗셈을 0이라고 한다(a³ ÷ a³ = 0).",
      "response": "자기 자신으로 나누면 1임을 수로 확인한다(S04, S14 ①)."
    },
    {
      "id": "M3",
      "text": "나누는 쪽 지수가 더 클 때 분모에 남기지 않는다(x³ ÷ x⁸ = x⁵).",
      "response": "분수로 풀어 써서 분모에 x가 남는 것을 본다(S04, S05 ④)."
    },
    {
      "id": "M4",
      "text": "곱·몫의 거듭제곱에서 계수나 분모의 수에 지수를 붙이지 않는다((3x)² = 3x², (3분의 x)² = 3분의 x²).",
      "response": "괄호 안의 식을 지수만큼 곱셈식으로 풀어 쓰고 값을 비교한다(S09, S11)."
    },
    {
      "id": "M5",
      "text": "음수의 거듭제곱에서 부호를 잘못 정하거나 (−x)²과 −x²을 같다고 본다.",
      "response": "음수를 곱한 횟수(짝수 +, 홀수 −)로 부호를 정하고 x = 3을 넣어 비교한다(S08, S14 ②)."
    }
  ],
