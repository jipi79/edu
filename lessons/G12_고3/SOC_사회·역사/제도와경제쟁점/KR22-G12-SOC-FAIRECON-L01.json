  "objectives": [
    {
      "id": "A",
      "text": "플랫폼 노동·자동화·플랫폼 독과점(누리국 예시)의 자료에서 시간당 순소득, 일자리 변화, 수수료 부담을 계산해 이익을 보는 쪽과 부담을 지는 쪽을 분석한다.",
      "evidence": "쟁점(S03), 플랫폼 노동(S05), 계산 연습(S06), 자동화(S07), 오개념 비교(S08), 독과점(S09), 혼자 해 보기(S13 ①②), 마무리(S15 ①), 활동지 1·2·4",
      "success": "자료의 숫자로 이익과 부담을 계산하고, 누가 이익을 보고 누가 부담을 지는지 말한다."
    },
    {
      "id": "B",
      "text": "효율과 형평 기준으로 경제 변화에 대한 정책 대안을 평가하고, 각 대안의 예상되는 위험(의도와 다른 결과)을 검토하며, 결론 대신 평가의 근거를 밝힌다.",
      "evidence": "효율과 형평(S04), 정책 대안 비교(S10), 정책 평가표 활동(S11), 오개념 비교(S12), 혼자 해 보기(S13 ③④), 마무리(S15 ②), 활동지 3",
      "success": "대안마다 효율·형평 평가와 까닭, 예상되는 위험을 하나 이상씩 쓰고, 다른 평가가 나오는 까닭을 기준으로 설명한다."
    }
  ],
  "materials": [
    "활동지",
    "연필",
    "계산기(있으면)"
  ],
  "boundary": "플랫폼 노동(시간당 순소득과 보호 공백), 자동화(일자리의 소멸과 생성), 플랫폼 독과점(수수료 결정력)에 나타난 공정성 쟁점, 효율과 형평 기준, 정책 대안(근로자 인정·별도 보호·시장 자율, 수수료 감시·경쟁 확대 등)의 평가와 예상되는 위험을 다룬다. 실제 회사·앱 이름, 실제 최저 임금 금액과 수수료율, 실제 법 개정과 판결, 근로자성 판단의 법적 기준, 소득 불평등 지표(지니 계수 등)의 계산은 다루지 않는다. 누리국의 사례와 숫자는 모두 지어낸 예시이다. 어느 정책 대안도 정답으로 정하지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "자동화는 일자리를 없애기만 한다.",
      "response": "무인 계산대 예시에서 없어진 일과 새로 생긴 일을 함께 세어 본다(S07, S08)."
    },
    {
      "id": "M2",
      "text": "형평을 높이는 정책은 반드시 효율을 떨어뜨린다.",
      "response": "재교육처럼 두 기준을 함께 높일 수 있는 방안을 예로 들어 정책마다 따져 보게 한다(S12)."
    },
    {
      "id": "M3",
      "text": "경제 변화를 한쪽(소비자 또는 노동자)의 처지에서만 판단한다.",
      "response": "이익을 보는 쪽과 부담을 지는 쪽을 나누어 계산하고, 의견을 나란히 비교한다(S05, S09, S10)."
    }
  ],
