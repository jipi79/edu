        ],
        "예상답": [
          "“막대는 실제로 나온 횟수, 점선은 이론값이요.” “72번 중 합 7이 14번으로 가장 많았고 이론값 12번보다 2번 많았어요.”"
        ],
        "막히면": [
          "‘가장 많은 것 → 그 수 → 이론값과 비교’ 순서로 말하게 합니다."
        ],
        "주의": [
          "그래프의 수는 예시 기록입니다. 아이는 자기 기록으로 활동지 2에 그립니다.",
          "막대그래프의 세로축은 0부터 시작해야 차이가 부풀려 보이지 않습니다."
        ]
      }
