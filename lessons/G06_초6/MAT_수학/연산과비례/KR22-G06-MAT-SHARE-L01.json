  "objectives": [
    {
      "id": "A",
      "text": "전체를 주어진 비로 나누는 비례배분을 (전항 + 후항)칸 띠 그림으로 이해하고, 전체 × (전항 ÷ (전항 + 후항))과 같은 식으로 나누어 준 양을 구한다.",
      "evidence": "비례배분하기(S05, S06, S10 ①②, S12, 활동지 1·2)",
      "success": "분모를 전항과 후항의 합으로 하여 두 양을 바르게 구하고, 띠 그림이나 식으로 설명한다."
    },
    {
      "id": "B",
      "text": "생활 문제(나누어 주기, 끈 자르기, 직사각형의 둘레)에서 무엇을 어떤 비로 나눌지 정해 비례배분하고, 두 양의 합이 전체인지와 두 양의 비가 주어진 비인지 확인한다.",
      "evidence": "생활 속 비례배분과 확인(S08, S09, S10 ③④, S12, 활동지 3·4·5)",
      "success": "직사각형은 둘레의 반을 나누는 것처럼 나눌 양을 바르게 정하고, 합과 비 두 가지로 답을 확인한다."
    }
  ],
  "materials": [
    "바둑돌 35개(또는 단추)",
    "종이 띠",
    "모눈종이",
    "활동지"
  ],
  "boundary": "자연수를 두 수의 비로 비례배분하여 나누어떨어지는 경우(답이 자연수)를 다룬다. 세 수의 비로 나누기, 소수·분수의 비로 나누기, 답이 분수인 비례배분은 다루지 않는다.",
  "misconceptions": [
    {
      "id": "M1",
      "text": "전항이나 후항을 분모로 쓴다(28을 3 : 4로 나눌 때 28 × 4분의 3).",
      "response": "띠를 (전항 + 후항)칸으로 그려 한 칸의 크기를 구하게 하고, 결과의 비가 주어진 비인지 확인한다(S03, S06)."
    },
    {
      "id": "M2",
      "text": "직사각형의 둘레 전체를 가로와 세로의 비로 나눈다(둘레 40 cm, 3 : 1 → 가로 30 cm).",
      "response": "둘레 = (가로 + 세로) × 2임을 짚고, 구한 가로·세로로 둘레를 다시 구해 확인한다(S07, S08)."
    },
    {
      "id": "M3",
      "text": "비의 순서를 바꾸어 배분하거나 합만 보고 맞다고 한다(36을 5 : 4로 → 16과 20).",
      "response": "전항이 누구의 몫인지 낱말을 먼저 쓰고, 합과 비 두 가지로 확인하게 한다(S12)."
    }
  ],
